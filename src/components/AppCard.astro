---
import type { PianoApp } from '../data/apps';
import MetaScoreBadge from './MetaScoreBadge.astro';
import CTA from './CTA.astro';
import { annualLine, reviewUrl, libraryLabel, inputLabel } from '../lib/format';

interface Props {
  app: PianoApp;
  rank?: number;
  showVerdict?: boolean;
}
const { app, rank, showVerdict = false } = Astro.props;
---

<article class={`card app-card${rank && rank <= 3 ? ' card-top3' : ''}`}>
  {rank && <span class="app-rank" aria-label={`Rank ${rank}`}>{String(rank).padStart(2, '0')}</span>}
  <div class="app-overview">
    <div class="app-heading">
      <span class="app-monogram" aria-hidden="true">{app.name.charAt(0)}</span>
      <h3><a href={reviewUrl(app)}>{app.name}</a></h3>
    </div>
    <p class="card-tagline">{app.tagline}</p>
    <div class="chips">
      <span class="chip">{libraryLabel(app)} songs</span>
      <span class="chip">{inputLabel(app.inputMethod)}</span>
      {app.platforms.map((p) => <span class="chip">{p}</span>)}
    </div>
    {showVerdict && <p class="card-verdict">{app.verdict}</p>}
  </div>
  <div class="app-decision">
    <div class="card-score"><MetaScoreBadge app={app} /></div>
    <p class="app-price">{annualLine(app)}</p>
    <div class="card-actions">
      <CTA app={app} />
      <a class="review-link" href={reviewUrl(app)}>Read our {app.name} review <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>
