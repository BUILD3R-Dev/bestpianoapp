---
/**
 * One ranked app. `row` is the wide ranking layout (rank · details · score and
 * actions); `tile` stacks the same content for 3-up grids.
 */
import type { PianoApp } from '../data/apps';
import MetaScoreBadge from './MetaScoreBadge.astro';
import CTA from './CTA.astro';
import { annualLine, reviewUrl, libraryLabel, inputLabel } from '../lib/format';

interface Props {
  app: PianoApp;
  rank?: number;
  showVerdict?: boolean;
  layout?: 'row' | 'tile';
  showCta?: boolean;
}
const { app, rank, showVerdict = false, layout = 'row', showCta = true } = Astro.props;
---

<article class:list={['app-card', `app-card--${layout}`, { 'is-top': rank && rank <= 3, 'is-first': rank === 1 }]}>
  {rank && <div class="app-rank"><span class="visually-hidden">Rank </span>{rank}</div>}
  <div class="app-main">
    <h3><a href={reviewUrl(app)}>{app.name}</a></h3>
    <p class="app-tagline">{app.tagline}</p>
    <ul class="chips" aria-label="Key facts">
      <li class="chip chip--price">{annualLine(app)}</li>
      <li class="chip">{libraryLabel(app)} songs</li>
      <li class="chip">{inputLabel(app.inputMethod)}</li>
      {app.platforms.map((p) => <li class="chip">{p}</li>)}
    </ul>
    {showVerdict && <p class="app-verdict">{app.verdict}</p>}
  </div>
  <div class="app-side">
    <MetaScoreBadge app={app} size="lg" />
    <div class="app-actions">
      {showCta && <CTA app={app} cls="btn-block" />}
      <a class:list={['btn', 'btn-block', { 'btn-ghost': showCta }]} href={reviewUrl(app)}>Read our {app.name} review</a>
    </div>
  </div>
</article>
