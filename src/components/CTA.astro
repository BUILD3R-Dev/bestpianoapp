---
import type { PianoApp } from '../data/apps';

interface Props {
  app: PianoApp;
  label?: string;
  ghost?: boolean;
  cls?: string;
}
const { app, label, ghost = false, cls = '' } = Astro.props;
const text = label ?? `Try ${app.name} — ${app.freeTrial.split('(')[0].trim()}`;
---

<a class={`btn${ghost ? ' btn-ghost' : ''}${cls ? ` ${cls}` : ''}`} href={app.affiliate.link} rel="sponsored nofollow">{text}</a>
