---
import { featuredApp } from '../data/apps';
import CTA from './CTA.astro';
import MetaScoreBadge from './MetaScoreBadge.astro';
import { annualLine } from '../lib/format';
---

{featuredApp ? (
  <aside class="featured-callout" aria-label="Featured partner">
    <div class="featured-main">
      <span class="tag">Featured partner</span>
      <h3>{featuredApp.name} — our launch partner</h3>
      <p class="featured-tagline">{featuredApp.tagline}</p>
      <p class="featured-note">Featured partner placement. Our rankings are computed from public ratings data and are never for sale. <a href="/disclosure/">How we make money</a>.</p>
    </div>
    <div class="featured-side">
      <MetaScoreBadge app={featuredApp} size="lg" />
      <p class="featured-price"><strong>{annualLine(featuredApp)}</strong><br />{featuredApp.freeTrial}</p>
      <CTA app={featuredApp} label={`Try ${featuredApp.name}`} cls="btn-gold btn-lg btn-block" />
    </div>
  </aside>
) : (
  <!--
    FEATURED SLOT (Appendix A): reserved for the WebPianoTeacher launch-partner app.
    Set `featured: true` on the app in src/data/apps.ts and this callout renders
    automatically on the homepage and /best-piano-apps/.
  -->
)}
