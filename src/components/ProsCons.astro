---
import type { PianoApp } from '../data/apps';

interface Props { app: PianoApp; id?: string }
const { app, id } = Astro.props;
---

<div class="proscons" id={id}>
  <div class="pros">
    <h3>Pros</h3>
    <ul>{app.pros.map((p) => <li>{p}</li>)}</ul>
  </div>
  <div class="cons">
    <h3>Cons</h3>
    <ul>{app.cons.map((c) => <li>{c}</li>)}</ul>
  </div>
</div>
