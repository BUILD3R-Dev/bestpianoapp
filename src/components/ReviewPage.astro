---
/**
 * Review page body for /{app}-review/. Wrapped in BaseLayout here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import MetaScoreBadge from './MetaScoreBadge.astro';
import ProsCons from './ProsCons.astro';
import VerdictBox from './VerdictBox.astro';
import CTA from './CTA.astro';
import DisclosureBlock from './DisclosureBlock.astro';
import LastVerified from './LastVerified.astro';
import FAQ from './FAQ.astro';
import { appBySlug, type App } from '../data/apps';
import { SITE } from '../data/site';
import { reviewEditorial, VS_PAIRS } from '../data/editorial';
import { reviewUrl, vsUrl, annualLine, inputLabel, libraryLabel } from '../lib/format';

const { appSlug } = Astro.props as { appSlug: string };
const app: App = appBySlug(appSlug);
const ed = reviewEditorial[app.slug];
const relatedVs = VS_PAIRS.filter(([a, b]) => a === app.slug || b === app.slug);
const title = app.slug === 'piano-tree'
  ? 'Piano Tree Review 2026: The Underdog Worth Watching'
  : `${app.name} Review (2026): Is It Worth It?`;
const description = `${app.name} review for 2026: MetaScore ${app.metaScore.toFixed(1)}/10 from public ratings, ${annualLine(app)} pricing, ${app.freeTrial}, pros, cons, and an honest verdict.`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: { '@type': 'Product', name: app.name, brand: { '@type': 'Brand', name: app.maker } },
  reviewRating: { '@type': 'Rating', ratingValue: app.metaScore, bestRating: 10, worstRating: 0 },
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---

<BaseLayout title={`${title} | ${SITE.name}`} description={description} schema={schema}>
  <div class="wrap-wide review-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Reviews', href: '/reviews/' }, { label: app.name }]} />
    <div class="review-intro"><div><h1>{title}</h1>
    <p class="lede">{ed.intro}</p>
    </div><div class="review-summary"><p><MetaScoreBadge app={app} /><a class="ms-how" href="/how-we-rate/">How the MetaScore works</a></p>
    <CTA app={app} />
    </div></div>
    <div class="review-grid"><aside class="review-facts" aria-labelledby="facts-title"><h2 id="facts-title">Quick facts</h2>
    <div class="cmp-scroll">
    <table class="cmp cmp--facts">
      <tbody>
        <tr><td><strong>Annual price</strong></td><td>{annualLine(app)}</td></tr>
        <tr><td><strong>Free trial</strong></td><td>{app.freeTrial}</td></tr>
        <tr><td><strong>Platforms</strong></td><td>{app.platforms.join(', ')}</td></tr>
        <tr><td><strong>How it hears you</strong></td><td>{inputLabel(app.inputMethod)}</td></tr>
        <tr><td><strong>Song library</strong></td><td>{libraryLabel(app)} songs</td></tr>
        <tr><td><strong>Course style</strong></td><td>{app.format === 'course' ? 'Structured course' : app.format === 'hybrid' ? 'Course + song library' : 'Song library'}</td></tr>
        <tr><td><strong>Skill levels</strong></td><td>{app.skillLevels.join(', ')}</td></tr>
        <tr><td><strong>Kids mode</strong></td><td>{app.kidsMode ? 'Yes' : 'No'}</td></tr>
      </tbody>
    </table>
    </div>
    </aside><div class="review-body">
    <ProsCons app={app} />
    <h2>How {app.name} teaches</h2>
    <p>{ed.methodNote}</p>
    <h2>Pricing: what it really costs</h2>
    <p>{ed.pricingDeepDive}</p>
    <CTA app={app} ghost label={`Compare ${app.name} on the full ranking`} />
    <h2>Who it is for — and who should skip it</h2>
    <p><strong>For:</strong> {ed.whoFor}</p>
    <p><strong>Skip it if:</strong> {ed.whoSkip}</p>
    <VerdictBox title={`${app.name} verdict`}>{app.verdict}</VerdictBox>
    <CTA app={app} />
    {relatedVs.length > 0 && (
      <Fragment>
        <h2>Head-to-head comparisons</h2>
        <ul>
          {relatedVs.map(([a, b]) => {
            const other = appBySlug(a === app.slug ? b : a);
            return (
              <li>
                <a href={vsUrl(appBySlug(a), appBySlug(b))}>{app.name} vs {other.name}</a>
              </li>
            );
          })}
        </ul>
      </Fragment>
    )}
    <FAQ items={ed.faqs} />
    </div></div>
    <DisclosureBlock />
    <LastVerified />
  </div>
</BaseLayout>
