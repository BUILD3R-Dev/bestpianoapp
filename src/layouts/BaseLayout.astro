---
import '../styles/global.css';
import { SITE, NAV, PERSONAS } from '../data/site';
import { rankedApps, appBySlug } from '../data/apps';
import { VS_PAIRS } from '../data/editorial';
import { reviewUrl, vsUrl } from '../lib/format';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
}

const { title, description, canonical, noindex, schema, ogType = 'article' } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const path = Astro.url.pathname;
// Which primary nav item owns this page (reviews, matchups, and persona pages roll up).
const section =
  path.startsWith('/best-piano-app-for-') ? '/best-piano-apps/'
  : path.endsWith('-review/') || path === '/is-flowkey-worth-it/' ? '/reviews/'
  : path.includes('-vs-') || path.endsWith('-alternatives/') ? '/compare/'
  : path;
const logo = `<svg viewBox="0 0 28 28" aria-hidden="true"><rect width="28" height="28" rx="7" fill="#17193f"/><rect x="5" y="7" width="4" height="14" rx="1" fill="#fff"/><rect x="10" y="7" width="4" height="14" rx="1" fill="#fff"/><rect x="15" y="7" width="4" height="14" rx="1" fill="#ffc43d"/><rect x="20" y="7" width="4" height="14" rx="1" fill="#fff"/><rect x="8" y="7" width="3" height="8" fill="#17193f"/><rect x="13" y="7" width="3" height="8" fill="#17193f"/><rect x="18.5" y="7" width="3" height="8" fill="#17193f"/></svg>`;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <!-- Google tag (gtag.js) — GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-90SRC65R4W"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-90SRC65R4W');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..700&display=swap" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='18' fill='%2317193f'/><rect x='18' y='28' width='12' height='44' fill='white'/><rect x='34' y='28' width='12' height='44' fill='white'/><rect x='50' y='28' width='12' height='44' fill='%23ffc43d'/><rect x='66' y='28' width='12' height='44' fill='white'/><rect x='28' y='28' width='9' height='26' fill='%2317193f'/><rect x='45' y='28' width='9' height='26' fill='%2317193f'/><rect x='62' y='28' width='9' height='26' fill='%2317193f'/></svg>" />
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site">
      <div class="container nav">
        <a class="brand" href="/"><Fragment set:html={logo} />BestPianoApp</a>
        <nav class="links" aria-label="Primary">
          {NAV.map((n) => <a href={n.href} aria-current={section === n.href ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <a class="btn btn-sm nav-cta" href="/quiz/" aria-current={path === '/quiz/' ? 'page' : undefined}>Take the quiz</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="brand" href="/"><Fragment set:html={logo} />BestPianoApp</a>
            <p>{SITE.tagline}</p>
            <a class="btn btn-gold btn-sm" href="/quiz/">Find your app in 60 seconds</a>
          </div>
          <nav aria-label="Rankings">
            <h2>Rankings</h2>
            <ul>
              <li><a href="/best-piano-apps/">Best piano apps</a></li>
              {PERSONAS.map((p) => <li><a href={p.url}>For {p.label === 'iPad' ? 'iPad' : p.label.toLowerCase()}</a></li>)}
              <li><a href="/best-keyboard-for-piano-apps/">Keyboards for apps</a></li>
              <li><a href="/best-digital-piano-for-beginners/">Digital pianos</a></li>
            </ul>
          </nav>
          <nav aria-label="Reviews">
            <h2>Reviews</h2>
            <ul>
              {rankedApps.map((a) => <li><a href={reviewUrl(a)}>{a.name}</a></li>)}
            </ul>
          </nav>
          <nav aria-label="Comparisons">
            <h2>Compare</h2>
            <ul>
              {VS_PAIRS.slice(0, 7).map(([a, b]) => {
                const A = appBySlug(a);
                const B = appBySlug(b);
                return <li><a href={vsUrl(A, B)}>{A.name} vs {B.name}</a></li>;
              })}
              <li><a href="/compare/">All comparisons</a></li>
            </ul>
          </nav>
          <nav aria-label="Footer">
            <h2>Site</h2>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/how-we-rate/">How we rate</a></li>
              <li><a href="/disclosure/">Affiliate disclosure</a></li>
              <li><a href="/deals/">Deals</a></li>
              <li><a href="/sitemap-index.xml">Sitemap</a></li>
            </ul>
          </nav>
        </div>
        <div class="footer-fine">
          <p>© 2026 bestpianoapp.com — The independent, data-driven guide to piano apps.</p>
          <p>We may earn a commission when you buy through links on this site. <a href="/disclosure/">Read our disclosure</a>.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
